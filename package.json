{
  "name": "aether-windows",
  "version": "1.0.0",
  "description": "Тема Windows из обоев Wallhaven",
  "author": "Aether",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev -p 4177 --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start -p 4177 --hostname 0.0.0.0",
    "lint": "eslint",
    "check": "tsx lib/palette.check.ts",
    "dist:win": "next build && node scripts/stage-standalone.mjs && electron-builder --win portable --x64"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.74.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.aether.windows",
    "productName": "Aether",
    "directories": { "output": "dist" },
    "files": ["electron/**/*"],
    "extraResources": [{ "from": ".next/standalone", "to": "standalone" }],
    "asar": true,
    "win": {
      "signAndEditExecutable": false,
      "target": [
        { "target": "portable", "arch": ["x64"] },
        { "target": "zip", "arch": ["x64"] }
      ]
    }
  }
}
